// ReachED ERD: business entities and their relationships (logical view).
// Based on docs/architecture/data-model.md (#138), with agreed review changes.
// School locations are recorded per school year to preserve location matching.
// Source: https://dbdiagram.io/d/ReachED-ERD-6acf49c2aebfe7a21fe5f61c

Table city_municipality {
  city_mun_psgc_code varchar(10) [pk, note: 'PSGC code or technical-member code']
  city_mun_name varchar(150) [not null, note: 'PSGC name']
  province_psgc_code varchar(10) [note: 'Parent province when applicable']
  province_name varchar(150)
  region_psgc_code varchar(10) [note: 'Stable parent region key']
  region_name varchar(100)
  lgu_type varchar(20)
  city_class varchar(3) [note: 'HUC, ICC, CC, or NULL for a municipality']
  income_class varchar(3) [note: '1st through 5th, or NULL when not classified']
  income_class_retained boolean
  land_area_sqkm decimal(18,4)
  land_area_source varchar(50)
  is_sga boolean
  member_type varchar(10) [not null, note: 'regular, unknown, or excluded']
  source_psgc_quarter varchar(10)
}

Table barangay {
  barangay_psgc_code varchar(10) [pk]
  barangay_name varchar(150) [not null]
  city_mun_psgc_code varchar(10) [not null]
  urban_rural varchar(1)
  member_type varchar(10) [not null, note: 'regular, unknown, or excluded']

  indexes {
    (barangay_psgc_code, city_mun_psgc_code) [unique]
  }
}

Table school {
  school_id varchar(20) [pk]
  school_name varchar(255) [not null]
}

Table school_year {
  school_year varchar(9) [pk, note: 'e.g. 2023-2024']
  start_year integer [not null]
  end_year integer [not null]
  has_enrollment boolean [not null]
  has_facilities boolean [not null]
  has_personnel boolean [not null]
}

Table education_level {
  education_level_code varchar(3) [pk, note: 'ES, JHS, or SHS']
  education_level_name varchar(50) [not null]
}

Table school_location [note: 'One row per school per school year; preserves year-specific location and PSGC matching.'] {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  city_mun_psgc_code varchar(10) [not null, note: 'Matched city or municipality, or a technical member; never NULL']
  barangay_psgc_code varchar(10) [not null, note: 'Matched barangay, or a technical member; never NULL']
  psgc_match_status varchar(10) [not null, note: 'matched, unmatched, ambiguous, or excluded']
  sector varchar(20)
  annex_status varchar(50)

  indexes {
    (school_id, school_year) [pk]
  }
}

Table enrollment_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  education_level_code varchar(3) [not null]
  is_offered boolean
  learner_count bigint [note: 'NULL remains distinct from zero; NULL only when all level counts are blank']

  indexes {
    (school_id, school_year, education_level_code) [pk]
  }
}

Table classroom_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  instructional_classrooms_total integer
  temporary_learning_spaces integer
  classes_using_temporary_learning_spaces integer
  makeshift_rooms integer
  classes_using_makeshift_rooms integer

  indexes {
    (school_id, school_year) [pk]
  }
}

Table personnel_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  education_level_code varchar(3) [not null]
  teacher_count integer
  sef_provincial_teacher_count integer
  sef_city_municipal_teacher_count integer
  lgu_funded_teacher_count integer
  other_funded_teacher_count integer

  indexes {
    (school_id, school_year, education_level_code) [pk]
  }
}

Table population_record {
  city_mun_psgc_code varchar(10) [not null]
  reference_year integer [not null]
  population bigint
  estimate_status varchar(12) [not null, note: 'available, missing, provisional, or excluded']
  status_reason varchar(255) [note: 'NULL when available']

  indexes {
    (city_mun_psgc_code, reference_year) [pk]
  }
}

Table school_age_population_record [note: 'Provisional: PSA 2020 CPH and 2024 POPCEN single-year-age population. Found, not yet profiled or ingested.'] {
  city_mun_psgc_code varchar(10) [not null]
  reference_year integer [not null]
  age integer [not null]
  sex varchar(6) [not null, note: 'male or female; both-sexes total is not stored']
  population bigint
  psgc_match_status varchar(10) [not null, note: 'Name-to-PSGC match result: matched, unmatched, ambiguous, or excluded']

  indexes {
    (city_mun_psgc_code, reference_year, age, sex) [pk]
  }
}

Table city_poverty {
  city_mun_psgc_code varchar(10) [pk, note: 'One row per PSGC city or municipality in the current source snapshot (D-046)']
  estimate_year integer [not null, note: 'Current source snapshot: 2023']
  poverty_incidence decimal(12,6) [note: 'Percent of persons; NULL unless estimated']
  poverty_ci90_lower decimal(12,6)
  poverty_ci90_upper decimal(12,6)
  poverty_cv decimal(12,6)
  poverty_cv_over_20 boolean [note: 'Shown as less precise when the CV is above 20 (D-046)']
  estimate_status varchar(14) [not null, note: 'estimated, no_estimate, or not_in_source']
  status_reason varchar(255) [note: 'Why there is no estimate; NULL when estimated (D-046)']
}

TableGroup geography {
  city_municipality
  barangay
}

TableGroup schools {
  school
  school_location
}

TableGroup school_reporting {
  enrollment_record
  classroom_record
  personnel_record
}

TableGroup reference {
  school_year
  education_level
}

TableGroup city_context {
  population_record
  school_age_population_record
  city_poverty
}

// Geography hierarchy
Ref: barangay.city_mun_psgc_code > city_municipality.city_mun_psgc_code

// School locations: one location record per school per school year
Ref: school_location.school_id > school.school_id
Ref: school_location.school_year > school_year.school_year
Ref: school_location.city_mun_psgc_code > city_municipality.city_mun_psgc_code

// School location to barangay; also ensures the barangay belongs to the recorded city/municipality
Ref: school_location.(barangay_psgc_code, city_mun_psgc_code) > barangay.(barangay_psgc_code, city_mun_psgc_code)

// School reporting records
Ref: enrollment_record.(school_id, school_year) > school_location.(school_id, school_year)
Ref: classroom_record.(school_id, school_year) > school_location.(school_id, school_year)
Ref: personnel_record.(school_id, school_year) > school_location.(school_id, school_year)

Ref: enrollment_record.education_level_code > education_level.education_level_code
Ref: personnel_record.education_level_code > education_level.education_level_code

// City/municipality population and poverty context
Ref: population_record.city_mun_psgc_code > city_municipality.city_mun_psgc_code
Ref: school_age_population_record.city_mun_psgc_code > city_municipality.city_mun_psgc_code
Ref: city_poverty.city_mun_psgc_code - city_municipality.city_mun_psgc_code