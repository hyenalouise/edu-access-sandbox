// ReachED ERD: real-world entities and how they relate (conceptual view).
// How each entity is stored in Gold, including technical members, match statuses,
// and availability flags, is in docs/architecture/data-model.md (#138).
// Source: https://dbdiagram.io/d/ReachED-ERD-6acf49c2aebfe7a21fe5f61c

Table region {
  region_psgc_code varchar(10) [pk]
  region_name varchar(100) [not null]
}

Table province {
  province_psgc_code varchar(10) [pk]
  province_name varchar(150) [not null]
  region_psgc_code varchar(10) [not null]
}

Table city_municipality {
  city_mun_psgc_code varchar(10) [pk]
  city_mun_name varchar(150) [not null]
  lgu_type varchar(20) [note: 'City or Municipality']
  city_class varchar(3) [note: 'HUC, ICC, CC; NULL for a municipality']
  income_class varchar(3) [note: '1st to 5th']
  land_area_sqkm decimal(18,4)
  is_sga boolean [note: 'Special Geographic Area municipality (D-031)']
  province_psgc_code varchar(10) [note: 'NULL for highly urbanized and independent component cities, and most of NCR']
  region_psgc_code varchar(10) [not null]
}

Table barangay {
  barangay_psgc_code varchar(10) [pk]
  barangay_name varchar(150) [not null]
  urban_rural varchar(1) [note: 'U or R (2020 CPH)']
  city_mun_psgc_code varchar(10) [not null]
}

Table school {
  school_id varchar(20) [pk]
  school_name varchar(255) [not null]
}

Table school_year {
  school_year varchar(9) [pk, note: 'e.g. 2023-2024']
  start_year integer [not null]
  end_year integer [not null]
}

Table education_level {
  education_level_code varchar(3) [pk, note: 'ES, JHS, or SHS (D-047)']
  education_level_name varchar(50) [not null]
}

Table school_location [note: 'Where a school is in a given school year. A school can move between school years, and AP4 compares years.'] {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  barangay_psgc_code varchar(10) [not null]
  sector varchar(20) [note: 'Public, Private, SUC/LUC, or PSO']
  annex_status varchar(50)

  indexes {
    (school_id, school_year) [pk]
  }
}

Table enrollment_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  education_level_code varchar(3) [not null]
  is_offered boolean
  learner_count bigint

  indexes {
    (school_id, school_year, education_level_code) [pk]
  }
}

Table classroom_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  instructional_classrooms_total integer
  temporary_learning_spaces integer
  makeshift_rooms integer

  indexes {
    (school_id, school_year) [pk]
  }
}

Table personnel_record {
  school_id varchar(20) [not null]
  school_year varchar(9) [not null]
  education_level_code varchar(3) [not null]
  teacher_count integer [note: 'D-047 teaching roles; principals and non-teaching staff excluded']
  locally_funded_teacher_count integer [note: 'Part of teacher_count']

  indexes {
    (school_id, school_year, education_level_code) [pk]
  }
}

Table population_record {
  city_mun_psgc_code varchar(10) [not null]
  reference_year integer [not null, note: '2024 (PSGC, D-033)']
  population bigint

  indexes {
    (city_mun_psgc_code, reference_year) [pk]
  }
}

Table school_age_population_record [note: 'Provisional: PSA 2020 CPH and 2024 POPCEN, not yet profiled. AP4 uses ages 5-17.'] {
  city_mun_psgc_code varchar(10) [not null]
  reference_year integer [not null, note: '2020 or 2024']
  age integer [not null]
  sex varchar(6) [not null, note: 'male or female']
  population bigint

  indexes {
    (city_mun_psgc_code, reference_year, age, sex) [pk]
  }
}

Table poverty_estimate [note: 'Context only. PSA publishes 2018, 2021, and 2023; Gold uses 2023 (D-046).'] {
  city_mun_psgc_code varchar(10) [not null]
  estimate_year integer [not null]
  poverty_incidence decimal(12,6) [note: 'Percent of persons']
  poverty_ci90_lower decimal(12,6)
  poverty_ci90_upper decimal(12,6)
  poverty_cv decimal(12,6)

  indexes {
    (city_mun_psgc_code, estimate_year) [pk]
  }
}

TableGroup geography {
  region
  province
  city_municipality
  barangay
}

TableGroup schools {
  school
  school_location
}

TableGroup school_reporting {
  enrollment_record
  classroom_record
  personnel_record
}

TableGroup reference {
  school_year
  education_level
}

TableGroup city_context {
  population_record
  school_age_population_record
  poverty_estimate
}

// Geography: region > province > city/municipality > barangay
Ref: province.region_psgc_code > region.region_psgc_code
Ref: city_municipality.province_psgc_code > province.province_psgc_code
Ref: city_municipality.region_psgc_code > region.region_psgc_code
Ref: barangay.city_mun_psgc_code > city_municipality.city_mun_psgc_code

// A school is in a barangay each school year
Ref: school_location.school_id > school.school_id
Ref: school_location.school_year > school_year.school_year
Ref: school_location.barangay_psgc_code > barangay.barangay_psgc_code

// Each school location has enrollment, classroom, and teacher records
Ref: enrollment_record.(school_id, school_year) > school_location.(school_id, school_year)
Ref: classroom_record.(school_id, school_year) > school_location.(school_id, school_year)
Ref: personnel_record.(school_id, school_year) > school_location.(school_id, school_year)
Ref: enrollment_record.education_level_code > education_level.education_level_code
Ref: personnel_record.education_level_code > education_level.education_level_code

// A city/municipality has population, school-age population, and poverty estimates
Ref: population_record.city_mun_psgc_code > city_municipality.city_mun_psgc_code
Ref: school_age_population_record.city_mun_psgc_code > city_municipality.city_mun_psgc_code
Ref: poverty_estimate.city_mun_psgc_code > city_municipality.city_mun_psgc_code