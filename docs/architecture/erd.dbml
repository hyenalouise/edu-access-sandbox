// ReachED ERD: business entities and their relationships (logical view; the Gold galaxy schema is in data-model.md).
// Source: https://dbdiagram.io/d/ReachED-ERD-6acf49c2aebfe7a21fe5f61c
// When the diagram changes, copy its code here and update the Mermaid diagram in erd.md in the same pull request.

Table city_municipality {
  psgc_code varchar(10) [primary key, note: 'Official PSGC code, or the code of an unknown or excluded member']
  member_type varchar(20) [not null, note: 'psgc, unknown, or excluded (Special Geographic Area schools, D-031)']
  lgu_name varchar(150) [not null]
  lgu_type varchar(20) [not null, note: 'City or Municipality']
  province varchar(150)
  region varchar(100)
  income_class varchar(30)
  area_sq_km decimal(12,2)
}

Table barangay {
  psgc_code varchar(10) [primary key, note: 'Official PSGC code, or the code of the unknown barangay of a city or municipality']
  member_type varchar(20) [not null, note: 'psgc or unknown; one unknown barangay per city or municipality']
  barangay_name varchar(150) [not null]
  city_mun_psgc_code varchar(10) [not null]
}

Table school {
  school_id varchar(20) [primary key, note: 'Official school identifier']
  school_name varchar(255) [not null]
}

Table enrollment_record {
  school_id varchar(20) [not null]
  school_year varchar(20) [not null]
  education_level varchar(3) [not null, note: 'ES, JHS, or SHS (D-047)']
  enrollment_count integer [not null, note: 'Number of enrolled learners at the level']
  region_name varchar(100) [note: 'As published by DepEd for that school year']
  province_name varchar(150) [note: 'As published by DepEd for that school year']
  city_municipality_name varchar(150) [note: 'As published by DepEd for that school year']
  barangay_name varchar(150) [note: 'As published by DepEd for that school year']
  city_mun_psgc_code varchar(10) [not null, note: 'Matched city or municipality, or the unknown or excluded member (D-029, D-031)']
  barangay_psgc_code varchar(10) [not null, note: 'Matched barangay, or the unknown barangay of the city or municipality']
  psgc_match_status varchar(20) [not null, note: 'matched, unmatched, ambiguous, excluded (D-029, D-031)']

  indexes {
    (school_id, school_year, education_level) [pk]
  }
}

Table classroom_record {
  school_id varchar(20) [not null]
  school_year varchar(20) [not null]
  classroom_count integer [note: 'Sum of the ES, JHS, and SHS instructional room counts that are not blank; NULL only when all three are blank (D-047)']

  indexes {
    (school_id, school_year) [pk]
  }
}

Table personnel_record {
  school_id varchar(20) [not null]
  school_year varchar(20) [not null]
  education_level varchar(3) [not null, note: 'ES, JHS, or SHS (D-047)']
  teacher_count integer [note: 'Teacher I-III, Master, Head, SPED/SNED, Special Science, Instructors, and locally funded teachers; principals and non-teaching staff excluded (D-047)']

  indexes {
    (school_id, school_year, education_level) [pk]
  }
}

Table population_record {
  psgc_code varchar(10) [not null, note: 'City or municipality PSGC code']
  reference_year integer [not null]
  total_population integer [note: 'PSGC 2024 Population (D-033)']

  indexes {
    (psgc_code, reference_year) [pk]
  }
}

Table school_age_population_record [note: 'Provisional: PSA Total Population by Single-Year Age, Sex, and City/Municipality, 2020 CPH and 2024 POPCEN. Found, not yet profiled or ingested; names only, no PSGC codes.'] {
  psgc_code varchar(10) [not null, note: 'City or municipality PSGC code, by name match (D-029)']
  reference_year integer [not null, note: '2020 (CPH) or 2024 (POPCEN)']
  age integer [not null, note: 'Single year of age; AP4 uses 5-17']
  sex varchar(10) [not null]
  population integer

  indexes {
    (psgc_code, reference_year, age, sex) [pk]
  }
}

Table poverty_record {
  psgc_code varchar(10) [primary key, note: 'City or municipality PSGC code; one row per city or municipality (D-046)']
  poverty_2023_incidence decimal(5,2) [note: 'Percent of persons; NULL unless status is estimated']
  poverty_2023_ci90_lower decimal(5,2)
  poverty_2023_ci90_upper decimal(5,2)
  poverty_2023_cv decimal(6,2)
  poverty_2023_cv_over_20 boolean
  poverty_2023_status varchar(20) [not null, note: 'estimated, no_estimate, or not_in_source (D-046)']
  poverty_2023_status_reason varchar(255)
}

Ref: barangay.city_mun_psgc_code > city_municipality.psgc_code
Ref: enrollment_record.city_mun_psgc_code > city_municipality.psgc_code
Ref: enrollment_record.barangay_psgc_code > barangay.psgc_code
Ref: enrollment_record.school_id > school.school_id
Ref: classroom_record.school_id > school.school_id
Ref: personnel_record.school_id > school.school_id
Ref: population_record.psgc_code > city_municipality.psgc_code
Ref: school_age_population_record.psgc_code > city_municipality.psgc_code
Ref: poverty_record.psgc_code - city_municipality.psgc_code
